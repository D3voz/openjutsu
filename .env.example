# Local ComfyUI behind comfy-api-proxy (no key needed).
COMFY_BASE_URL=http://127.0.0.1:8189
# Only for a Comfy Developer Platform deployment or Comfy Cloud.
COMFY_API_KEY=
# ComfyUI itself (not the proxy), only to fill the base model and LoRA pickers. Leave empty for 127.0.0.1:8188.
COMFYUI_URL=
# Required before hosting or tunneling the app. Browser login: username openjutsu. Use HTTPS remotely.
OPENJUTSU_PASSWORD=
# Token for machine clients: Authorization: Bearer <key> (or x-api-key). Leave empty to use only the browser login.
OPENJUTSU_API_KEY=
# SQLite file for job history and the API. Default: data/openjutsu.db
OPENJUTSU_DB_PATH=
# Set to "off" to skip the local database entirely.
OPENJUTSU_DB=
