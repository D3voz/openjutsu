  },
  "7": {
    "inputs": { "frame_rate": 24, "loop_count": 0, "filename_prefix": "openjutsu_fit/fit", "format": "video/h264-mp4", "pix_fmt": "yuv420p", "crf": 19, "save_metadata": false, "trim_to_audio": false, "pingpong": false, "save_output": false, "images": ["6", 0] },
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Fit preview video" }
  }
