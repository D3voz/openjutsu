{
  "1": {
    "inputs": { "video": "", "force_rate": 24, "custom_width": 0, "custom_height": 0, "frame_load_cap": 0, "skip_first_frames": 0, "select_every_nth": 1, "format": "None" },
    "class_type": "VHS_LoadVideo",
    "_meta": { "title": "Source video" }
  },
  "2": {
    "inputs": { "ckpt_name": "sam3.1_multiplex_fp16.safetensors" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "SAM 3.1" }
  },
  "3": {
    "inputs": { "text": "person", "clip": ["2", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "SAM: people" }
  },
