{
  "name": "openjutsu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test --experimental-strip-types test/*.test.ts && tsc --noEmit",
    "db": "node --experimental-strip-types scripts/db.ts",
    "db:init": "node --experimental-strip-types scripts/db.ts init",
    "db:info": "node --experimental-strip-types scripts/db.ts info",
    "db:list": "node --experimental-strip-types scripts/db.ts list",
    "db:export": "node --experimental-strip-types scripts/db.ts export",
    "db:import": "node --experimental-strip-types scripts/db.ts import",
    "db:backup": "node --experimental-strip-types scripts/db.ts backup",
    "db:restore": "node --experimental-strip-types scripts/db.ts restore",
    "db:prune": "node --experimental-strip-types scripts/db.ts prune",
    "db:vacuum": "node --experimental-strip-types scripts/db.ts vacuum"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@comfyorg/sdk": "0.5.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
